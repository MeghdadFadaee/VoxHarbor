# Deployment/operator settings only. Enter TeamSpeak connections in the signed-in app.
APP_ORIGIN=http://localhost:3000
# Optional reserved owner login; preserve an existing value. Generate with npm run owner:hash.
OWNER_PASSWORD_HASH=
# Public signup: 1 enables registration; 0 closes signup without disabling existing accounts.
ALLOW_REGISTRATION=1
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Required in production: one complete owner-controlled Redis REST credential pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace KV_REST_API_URL + KV_REST_API_TOKEN are also supported.
# Development only; rejected in production. Redis is required for persistence.
ALLOW_LOCAL_MEMORY_STORE=1
# Generate once with npm run identity:key. Preserve across redeployments.
IDENTITY_ENCRYPTION_KEY=
# Only during explicit key rotation; see docs/IDENTITY.md.
IDENTITY_PREVIOUS_ENCRYPTION_KEY=

{
  "name": "voxharbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/prepare-audio.mjs && node --env-file-if-exists=.env.local scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "owner:hash": "node scripts/hash-password.mjs",
    "owner:setup": "node scripts/hash-password.mjs --save",
    "identity:key": "node scripts/identity-key.mjs",
    "native:build": "node scripts/prepare-audio.mjs && node scripts/build-native.mjs",
    "audio:qa": "node scripts/prepare-audio.mjs && node scripts/audio-browser-qa.mjs",
    "deployment:package": "node scripts/package-deployment.mjs",
    "publication:check": "node scripts/publication-check.mjs",
    "publication:package": "node scripts/package-publication.mjs",
    "icons:build": "node scripts/generate-app-icons.mjs"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "libopus-wasm": "0.3.0",
    "ws": "^8.18.3"
  },
  "description": "Private, self-hosted TeamSpeak 3 web client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeghdadFadaee/VoxHarbor.git"
  },
  "bugs": {
    "url": "https://github.com/MeghdadFadaee/VoxHarbor/issues"
  }
}
